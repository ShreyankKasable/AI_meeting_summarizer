{
  "name": "ai-meeting-summarizer",
  "version": "2.0.0",
  "description": "AI-powered meeting summarizer with action item tracking — pure JavaScript",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "start:backend": "node backend/index.js",
    "start:electron": "electron .",
    "build": "electron-builder"
  },
  "keywords": [
    "meeting",
    "transcription",
    "ai",
    "summarizer",
    "action-items"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.27.0",
    "@notionhq/client": "^2.2.15",
    "axios": "^1.6.7",
    "compression": "^1.8.1",
    "convict": "^6.2.5",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "electron-store": "^8.1.0",
    "express": "^4.19.2",
    "googleapis": "^140.0.1",
    "helmet": "^8.2.0",
    "jira-client": "^8.2.2",
    "lodash": "^4.18.1",
    "openai": "^4.56.0",
    "socket.io": "^4.7.5",
    "socket.io-client": "^4.7.5"
  },
  "devDependencies": {
    "electron": "^28.2.0",
    "electron-builder": "^24.9.1"
  },
  "build": {
    "appId": "com.aimeetingsummarizer.app",
    "productName": "AI Meeting Summarizer",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**/*",
      "frontend/**/*",
      "backend/**/*",
      "data/**/*"
    ],
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": "dmg"
    },
    "linux": {
      "target": "AppImage"
    }
  }
}
